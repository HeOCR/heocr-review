// HeOCR Review: one Worker serves the static site (public/: / home, /privacy, /terms, /app the review app)
// and the API (/api/*).
// Never put DEV_AUTH_BYPASS here: the dev sign-in exists only through .dev.vars on a loopback host
// (see src/worker/auth/dev.ts and test/worker/guards.test.ts).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "heocr-review",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  // Production answers on both hosts: the custom domain (review.heocr.org, zone heocr.org, 2026-11-19) and
  // heocr-review.heocr.workers.dev, so links made before the domain keep working. Sessions are host-only cookies.
  "workers_dev": true,
  "preview_urls": false,
  "routes": [{ "pattern": "review.heocr.org", "custom_domain": true }],
  "observability": { "enabled": false },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "ENVIRONMENT": "production",
    // Public OAuth client id (not a secret); set by scripts/deploy.ts from ~/.config/heocr/cloudflare.env.
    "GOOGLE_CLIENT_ID": ""
  },
  // Secrets (wrangler secret put): SESSION_SECRET, REVIEWER_ID_SECRET, ADMIN_REVIEWER_IDS.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "heocr-review",
      "database_id": "81219ea7-28f8-4f49-952f-bb109645429f",
      "migrations_dir": "migrations"
    }
  ],
  "env": {
    "preview": {
      "name": "heocr-review-preview",
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "ENVIRONMENT": "preview",
        "GOOGLE_CLIENT_ID": ""
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "heocr-review-preview",
          "database_id": "f942b3af-e259-40dc-9547-18c2c9e80110",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
