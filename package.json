{
  "name": "heocr-review",
  "version": "0.1.0",
  "private": true,
  "description": "HeOCR Review: volunteers review correction proposals against Hebrew page scans",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build-web.mjs",
    "dev": "npm run build && wrangler dev",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.web.json && tsc -p tsconfig.node.json && tsc -p test/worker/tsconfig.json",
    "test": "npm run build && VITE_CONFIG_NATIVE_IGNORE_WARNING=true vitest run",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "import": "tsx scripts/import.ts",
    "export": "tsx scripts/export.ts",
    "deploy:preview": "tsx scripts/deploy.ts preview"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.5.1",
    "@cloudflare/workers-types": "^5.20261104.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "~4.1.12",
    "wrangler": "^4.157.0"
  }
}
